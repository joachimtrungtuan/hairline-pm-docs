# Export these values in the terminal or an untracked local environment file.
# Never commit real credentials or IDs here.
HAIRLINE_BASE_URL=https://admin.hairline.app
HAIRLINE_API_URL=https://backend.hairline.app/api
HAIRLINE_HEADLESS=false
HAIRLINE_BROWSER_EXECUTABLE=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
HAIRLINE_PROVIDER_EMAIL=
HAIRLINE_PROVIDER_PASSWORD=
HAIRLINE_PROVIDER_ACCOUNT=V1
HAIRLINE_PATIENT_EMAIL=
HAIRLINE_PATIENT_PASSWORD=
HAIRLINE_PATIENT_ACCOUNT=P1
HAIRLINE_RESTRICTED_PROVIDER_EMAIL=
HAIRLINE_RESTRICTED_PROVIDER_PASSWORD=
HAIRLINE_RESTRICTED_PROVIDER_ACCOUNT=S1

# Optional override if the globally installed Playwright MCP moves.
HAIRLINE_PLAYWRIGHT_HOST_PACKAGE=/opt/homebrew/lib/node_modules/@playwright/mcp/package.json
